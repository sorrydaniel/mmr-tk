# Required. Railway supplies postgresql://... ; the app rewrites it to postgresql+psycopg://
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional. Absent -> the app uses the mock converter and shows a yellow banner.
ANTHROPIC_API_KEY=

# Optional. Default: claude-sonnet-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional but strongly recommended on a public URL: one shared password for the whole app.
APP_PASSWORD=

# Signs the session cookie. If unset it is generated per process, which logs everyone out on
# every restart and breaks login entirely if more than one worker runs. Set it in production.
SECRET_KEY=

# Optional. Adds Secure to the session cookie. Off by default because Railway terminates TLS
# at its proxy, so the app itself only ever sees plain HTTP.
SESSION_HTTPS_ONLY=
